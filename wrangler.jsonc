{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novasite-launch",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/sitemap.xml"]
  },
  "observability": {
    "enabled": true
  }
}
