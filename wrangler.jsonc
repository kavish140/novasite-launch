{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novasite-launch",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  // next-themes serializes its startup function into HTML. Name-preservation
  // helpers would reference server-only __name from that browser script.
  "keep_names": false,
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": [
      "/sitemap.xml",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
