{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novasite-launch",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.js",
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
