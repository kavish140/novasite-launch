diff --git a/supabase/functions/_shared/reconciliation.ts b/supabase/functions/_shared/reconciliation.ts
index e69de29..c49c7ab 100644
--- /dev/null
+++ b/supabase/functions/_shared/reconciliation.ts
@@ -0,0 +1,48 @@
+import { z } from "zod";
+import { paymentStore, type PaymentRecord } from "./payment-store.ts";
+import { fetchStoredPaymentStatus, paymentJson, type PaymentEnv } from "./razorpay.ts";
+
+export async function reconcileOne(env: PaymentEnv, runId: string, record: PaymentRecord) {
+  const store=paymentStore(env);
+  try {
+    const status=await fetchStoredPaymentStatus(env,record);
+    const state=await store.recordReconciliation(runId,record,status,null);
+    return {state,error:false};
+  } catch {
+    // Never persist provider bodies, authorization headers or raw exceptions.
+    await store.recordReconciliation(runId,record,{status:"pending"},"Provider verification or ledger update failed; owner review required.");
+    return {state:"needs_reconciliation",error:true};
+  }
+}
+export async function handleReconciliation(request: Request, env: PaymentEnv) {
+  if(request.method!=="POST") return paymentJson({error:"Method not allowed"},405);
+  const token=request.headers.get("x-payment-scheduler-token")??"";
+  if(!/^[a-f0-9]{64}$/.test(token)) return paymentJson({error:"Unauthorized"},401);
+  const store=paymentStore(env);
+  let runId:string|undefined,checked=0,errors=0;
+  try {
+    if(!await store.verifyScheduler(token)) return paymentJson({error:"Unauthorized"},401);
+    const raw=await request.text();if(raw.length>1000) return paymentJson({error:"Request too large"},413);
+    runId=z.object({runId:z.string().uuid()}).strict().parse(JSON.parse(raw)).runId;
+    if(!await store.claimRun(runId)) return paymentJson({alreadyProcessed:true});
+    const before=new Date(Date.now()-15*60000).toISOString();
+    const deadline=Date.now()+110000;
+    let after:string|undefined;
+    while(true){
+      const records=await store.dueOrders(before,after);
+      if(!records.length) break;
+      for(let offset=0;offset<records.length;offset+=4){
+        if(Date.now()>deadline) throw new Error("Run time budget exceeded");
+        const results=await Promise.all(records.slice(offset,offset+4).map(record=>reconcileOne(env,runId!,record)));
+        checked+=results.length; errors+=results.filter(result=>result.error).length;
+      }
+      after=records.at(-1)!.request_id;
+      if(records.length<100) break;
+    }
+    await store.finishRun(runId,checked,errors,errors?"One or more orders need owner review.":null);
+    return paymentJson({checked,errors});
+  } catch {
+    if(runId){try{await store.finishRun(runId,checked,errors+1,"Reconciliation did not complete; retry scheduled.");}catch{/* SQL watchdog flags abandoned runs. */}}
+    return paymentJson({error:"Reconciliation unavailable"},503);
+  }
+}
diff --git a/supabase/functions/_shared/admin-payments.ts b/supabase/functions/_shared/admin-payments.ts
index e69de29..48dabed 100644
--- /dev/null
+++ b/supabase/functions/_shared/admin-payments.ts
@@ -0,0 +1,34 @@
+import {z} from "zod";
+import {paymentJson,type PaymentEnv,type VerifiedTestAdmin} from "./razorpay.ts";
+import {paymentStore} from "./payment-store.ts";
+import {reconcileOne} from "./reconciliation.ts";
+
+// Called only after the gateway verifies Auth identity AND site_admins membership.
+export async function adminPayments(request: Request, env: PaymentEnv, action: string, admin: VerifiedTestAdmin) {
+  if(!admin?.id) return paymentJson({error:"Admin sign-in required"},401);
+  if(!["queue","history","recheck"].includes(action)) return paymentJson({error:"Not found"},404);
+  let run:string|undefined;
+  const store=paymentStore(env);
+  try {
+    if(!await env.PAYMENT_RATE_LIMITER?.limit({key:`check:admin:${admin.id}`}).then(result=>result.success)) return paymentJson({error:"Too many checks. Try again in a minute."},429);
+    const raw=await request.text();if(raw.length>1000)return paymentJson({error:"Request too large"},413);
+    const body=JSON.parse(raw);
+    const offset=z.number().int().min(0).max(100000).default(0);
+    if(action==="queue"){
+      const input=z.object({offset}).strict().parse(body);
+      return paymentJson(await store.queue(input.offset));
+    }
+    const input=z.object({requestId:z.string().uuid(),...(action==="history"?{offset}:{})}).strict().parse(body);
+    const record=await store.byRequest(input.requestId);
+    if(!record) return paymentJson({error:"Order not found"},404);
+    if(action==="history") return paymentJson(await store.history(input.requestId,(input as {offset:number}).offset));
+    run=await store.startRun("admin");
+    const result=await reconcileOne(env,run,record);
+    await store.finishRun(run,1,result.error?1:0,result.error?"Provider verification failed; owner review required.":null);
+    return paymentJson({state:result.state,needsReview:result.error});
+  } catch(error) {
+    if(run){try{await store.finishRun(run,0,1,"Admin reconciliation did not complete; owner review required.");}catch{/* Cron watchdog flags abandoned runs. */}}
+    if(error instanceof z.ZodError || error instanceof SyntaxError) return paymentJson({error:"Invalid payment request"},400);
+    return paymentJson({error:"Unable to check payments. Try again later."},503);
+  }
+}
