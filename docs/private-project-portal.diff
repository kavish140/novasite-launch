assName="mt-4 text-sm"><summary className="cursor-pointer">Balance check history</summary>{project.history.map((item,index)=><p key={index} className="mt-2 break-words">{new Date(item.created_at).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"})} IST · {item.order_id??"Order unavailable"} · {item.source} · {item.old_state} → {item.new_state}{item.error?` · ${item.error}`:""}</p>)}</details>}</article>)}</div>
