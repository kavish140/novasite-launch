diff --git a/supabase/functions/_shared/payment-health.ts b/supabase/functions/_shared/payment-health.ts
--- /dev/null
+++ b/supabase/functions/_shared/payment-health.ts
@@ -0,0 +1,20 @@
+export type Dispute = {id:string; event:string; status:string; paymentId:string|null; orderId:string|null; amount:number|null; currency:string|null; responseDueAt:string|null; occurredAt:string|null};
+export type DisputeEvent = {event_id:string;processed_at:string;dispute:Dispute};
+const closed=new Set(["won","lost","closed"]);
+// Event time, rather than delivery time, prevents late delivery reopening a dispute.
+export function openDisputes(events:DisputeEvent[]):Dispute[]{
+ const latest=new Map<string,DisputeEvent>();
+ for(const row of events){
+  const key=row.dispute.id||row.event_id,previous=latest.get(key);
+  const at=Date.parse(row.dispute.occurredAt??row.processed_at),before=previous?Date.parse(previous.dispute.occurredAt??previous.processed_at):-Infinity;
+  if(!previous||at>before||(at===before&&closed.has(row.dispute.status))) latest.set(key,row);
+ }
+ return [...latest.values()].map(row=>row.dispute).filter(dispute=>!closed.has(dispute.status)).sort((a,b)=>(a.responseDueAt??"9999").localeCompare(b.responseDueAt??"9999"));
+}
+export type PaymentHealth = {observedAt:string;latestRunFailed:boolean;lastCompletedAt:string|null;lastSuccessfulAt:string|null;needsReconciliation:number;overdue:number;refunded:number;disputes:Dispute[]};
+export function staleCron(health:PaymentHealth,now=Date.now()){
+ return !health.lastCompletedAt || now-Date.parse(health.lastCompletedAt)>30*60000;
+}
+export function paymentAlertCount(health:PaymentHealth,now=Date.now()){
+ return Number(health.latestRunFailed)+Number(staleCron(health,now))+health.needsReconciliation+health.overdue+health.refunded+health.disputes.length;
+}
diff --git a/supabase/migrations/20261011100002_payment_dispute_audit.sql b/supabase/migrations/20261011100002_payment_dispute_audit.sql
--- /dev/null
+++ b/supabase/migrations/20261011100002_payment_dispute_audit.sql
@@ -0,0 +1,17 @@
+begin;
+-- Additive, record-only metadata. Existing settlement RPCs are unchanged.
+alter table public.payment_webhook_events add column event_type text;
+alter table public.payment_webhook_events add column dispute jsonb;
+create index payment_webhook_dispute_events on public.payment_webhook_events(processed_at,id) where dispute is not null;
+create function public.record_payment_dispute_event(p_event text,p_type text,p_order text,p_dispute jsonb)
+returns boolean language plpgsql security invoker set search_path='' as $$
+declare inserted text;
+begin
+ if p_type not like 'payment.dispute.%' or jsonb_typeof(p_dispute) is distinct from 'object' or octet_length(p_dispute::text)>8000 then raise exception 'invalid_dispute_event'; end if;
+ insert into public.payment_webhook_events(event_id,event_type,order_id,dispute)
+ values(p_event,p_type,p_order,p_dispute) on conflict(event_id) do nothing returning event_id into inserted;
+ return inserted is not null;
+end;$$;
+revoke all on function public.record_payment_dispute_event(text,text,text,jsonb) from public,anon,authenticated;
+grant execute on function public.record_payment_dispute_event(text,text,text,jsonb) to service_role;
+commit;
